<html>
<head>
<title>出貨排車產生器</title>
<HTA:APPLICATION
  ID="dispatchPlannerApp"
  APPLICATIONNAME="出貨排車產生器"
  BORDER="thin"
  CAPTION="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SCROLL="no"
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
/>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: #f1eee7;
    color: #23262a;
    font-family: "Microsoft JhengHei UI", "Microsoft JhengHei", "Segoe UI", sans-serif;
    font-size: 13px;
  }
  .wrap { padding: 20px 24px; }
  h1 {
    font-size: 18px; font-weight: 700; margin: 0 0 2px;
  }
  .sub { color: #6e7168; font-size: 12px; margin-bottom: 18px; }

  .field-row {
    display: flex; align-items: center; gap: 10px; margin-bottom: 10px;
  }
  .field-row label {
    width: 108px; flex: none; color: #23262a; font-size: 12.5px;
  }
  .field-row input {
    flex: 1; padding: 5px 8px; border: 1px solid #dad5c8; border-radius: 4px;
    background: #ffffff; color: #23262a; font-size: 13px;
    font-family: "Consolas", "Microsoft JhengHei UI", monospace;
  }
  .field-row .hint { color: #9a9587; font-size: 11px; flex: none; width: 70px; }

  .actions { margin: 16px 0 10px; display: flex; gap: 10px; align-items: center; }
  button#runBtn {
    background: #2e5f73; color: #fff; border: none; border-radius: 5px;
    padding: 8px 18px; font-size: 13px; font-weight: 600; cursor: pointer;
  }
  button#runBtn:disabled { background: #9aa7ab; cursor: default; }
  button#openBtn {
    background: #e9e4d8; color: #23262a; border: 1px solid #dad5c8; border-radius: 5px;
    padding: 8px 14px; font-size: 12.5px; cursor: pointer;
  }
  button#openBtn:disabled { color: #b3afa3; cursor: default; }
  button#zipBtn {
    background: #b98a55; color: #fff; border: none; border-radius: 5px;
    padding: 8px 14px; font-size: 12.5px; cursor: pointer;
  }
  button#zipBtn:disabled { background: #d8cbb3; cursor: default; }

  .status-pill {
    display: inline-block; font-size: 11.5px; padding: 3px 10px; border-radius: 100px;
    background: #e9e4d8; color: #6e7168;
  }
  .status-pill.running { background: #dde8ea; color: #2e5f73; }
  .status-pill.ok { background: #e3f0e7; color: #2f7a4c; }
  .status-pill.err { background: #f6e2df; color: #a5352a; }

  #log {
    margin-top: 14px; width: 100%; height: 190px; resize: none;
    background: #1c2126; color: #d8e0e4; border: 1px solid #333a40; border-radius: 5px;
    font-family: "Consolas", monospace; font-size: 11.5px; padding: 8px; overflow-y: scroll;
    white-space: pre-wrap;
  }
</style>
</head>
<body onload="init()">
<div class="wrap">
  <h1>出貨排車 &amp; 3D裝載模擬 產生器</h1>
  <div class="sub">選日期,按「產生報表」就會查ERP、排車、產生HTML報表</div>

  <div class="field-row">
    <label>資料日期</label>
    <input type="text" id="dateInput" placeholder="yyyy-MM-dd">
    <span class="hint">必填</span>
  </div>
  <div class="field-row">
    <label>車廂長 L (mm)</label>
    <input type="text" id="truckL" placeholder="留空用 config.json 預設值">
    <span class="hint">選填</span>
  </div>
  <div class="field-row">
    <label>車廂寬 W (mm)</label>
    <input type="text" id="truckW" placeholder="留空用 config.json 預設值">
    <span class="hint">選填</span>
  </div>
  <div class="field-row">
    <label>車廂高 H (mm)</label>
    <input type="text" id="truckH" placeholder="留空用 config.json 預設值">
    <span class="hint">選填</span>
  </div>

  <div class="actions">
    <button id="runBtn" onclick="runReport()">產生報表</button>
    <button id="openBtn" onclick="openReport()" disabled>開啟報表</button>
    <button id="zipBtn" onclick="packageZip()" disabled>打包下載</button>
    <span class="status-pill" id="statusPill">尚未執行</span>
  </div>

  <textarea id="log" readonly></textarea>
</div>

<script language="VBScript">
Dim rootDir, lastHtmlPath, lastDate

Sub init()
  rootDir = Left(document.location.pathname, InStrRev(document.location.pathname, "\"))
  dateInput.value = FormatDateTag(Now)
  appendLog "就緒。專案資料夾: " & rootDir
End Sub

' HTA has no WScript.Sleep (that's WSH-only) -- busy-wait on Timer() instead.
Sub BusyWait(ms)
  Dim t0
  t0 = Timer
  Do While Abs(Timer - t0) < ms / 1000
  Loop
End Sub

Function FormatDateTag(d)
  FormatDateTag = Year(d) & "-" & Right("0" & Month(d), 2) & "-" & Right("0" & Day(d), 2)
End Function

Sub appendLog(s)
  log.value = log.value & s & vbCrLf
  log.scrollTop = log.scrollHeight
End Sub

Sub setStatus(cls, txt)
  statusPill.className = "status-pill " & cls
  statusPill.innerText = txt
End Sub

Sub runReport()
  Dim d, cmd, shell, exec, line
  d = Trim(dateInput.value)
  If d = "" Then
    MsgBox "請先輸入資料日期,格式 yyyy-MM-dd"
    Exit Sub
  End If

  runBtn.disabled = True
  openBtn.disabled = True
  zipBtn.disabled = True
  log.value = ""
  setStatus "running", "執行中..."
  appendLog "== 開始產生 " & d & " 的排車報表 =="

  cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -File """ & rootDir & "run.ps1"" -Date " & d
  If Trim(truckL.value) <> "" Then cmd = cmd & " -TruckL " & Trim(truckL.value)
  If Trim(truckW.value) <> "" Then cmd = cmd & " -TruckW " & Trim(truckW.value)
  If Trim(truckH.value) <> "" Then cmd = cmd & " -TruckH " & Trim(truckH.value)

  Set shell = CreateObject("WScript.Shell")
  Set exec = shell.Exec(cmd)

  Do While exec.Status = 0
    Do While Not exec.StdOut.AtEndOfStream
      appendLog exec.StdOut.ReadLine()
    Loop
    Do While Not exec.StdErr.AtEndOfStream
      appendLog "[stderr] " & exec.StdErr.ReadLine()
    Loop
    BusyWait 150
  Loop
  Do While Not exec.StdOut.AtEndOfStream
    appendLog exec.StdOut.ReadLine()
  Loop
  Do While Not exec.StdErr.AtEndOfStream
    appendLog "[stderr] " & exec.StdErr.ReadLine()
  Loop

  runBtn.disabled = False

  If exec.ExitCode = 0 Then
    lastDate = d
    lastHtmlPath = rootDir & "output\dispatch_" & d & ".html"
    setStatus "ok", "完成"
    appendLog "== 完成 =="
    openBtn.disabled = False
    zipBtn.disabled = False
    openReport()
  Else
    setStatus "err", "失敗(結束碼 " & exec.ExitCode & ")"
    appendLog "== 執行失敗,請檢查上面的訊息 =="
  End If
End Sub

Sub openReport()
  Dim shell
  If lastHtmlPath = "" Then Exit Sub
  Set shell = CreateObject("WScript.Shell")
  shell.Run """" & lastHtmlPath & """"
End Sub

' Builds an empty .zip (the minimal 22-byte "end of central directory" record),
' written as an ANSI text file since each Chr() maps 1:1 to a byte -- the classic
' VBScript zip-creation trick that Windows Explorer's Shell.Application understands.
Sub CreateEmptyZip(zipPath)
  Dim fso, f
  Set fso = CreateObject("Scripting.FileSystemObject")
  If fso.FileExists(zipPath) Then fso.DeleteFile zipPath, True
  Set f = fso.CreateTextFile(zipPath, True)
  f.Write "PK" & Chr(5) & Chr(6) & String(18, Chr(0))
  f.Close
End Sub

' CopyHere is asynchronous -- wait until the zip's item count actually increases
' before adding the next file, otherwise overlapping copies can silently drop files.
Sub AddToZip(zipFolder, filePath)
  Dim countBefore, waited
  countBefore = zipFolder.Items().Count
  zipFolder.CopyHere filePath, 4 + 16 ' 4=no progress dialog, 16=respond "yes to all"
  waited = 0
  Do While zipFolder.Items().Count <= countBefore And waited < 10000
    BusyWait 200
    waited = waited + 200
  Loop
  BusyWait 200
End Sub

Sub packageZip()
  Dim fso, shellApp, zipPath, zipFolder, candidates(2), i, added
  If lastDate = "" Then Exit Sub

  zipBtn.disabled = True
  setStatus "running", "打包中..."
  appendLog "== 打包 " & lastDate & " 的輸出檔案 =="

  Set fso = CreateObject("Scripting.FileSystemObject")
  zipPath = rootDir & "output\dispatch_package_" & lastDate & ".zip"
  CreateEmptyZip zipPath

  Set shellApp = CreateObject("Shell.Application")
  Set zipFolder = shellApp.NameSpace(zipPath)

  candidates(0) = rootDir & "output\orders_" & lastDate & ".csv"
  candidates(1) = rootDir & "output\dispatch_sheet_" & lastDate & ".csv"
  candidates(2) = rootDir & "output\dispatch_" & lastDate & ".html"

  added = 0
  For i = 0 To UBound(candidates)
    If fso.FileExists(candidates(i)) Then
      appendLog "  加入: " & fso.GetFileName(candidates(i))
      AddToZip zipFolder, candidates(i)
      added = added + 1
    End If
  Next

  zipBtn.disabled = False
  If added = 0 Then
    setStatus "err", "打包失敗"
    appendLog "== 找不到任何輸出檔案可打包 =="
    Exit Sub
  End If

  setStatus "ok", "打包完成"
  appendLog "== 打包完成: " & zipPath & " =="
  shellApp.Explore rootDir & "output"
End Sub
</script>
</body>
</html>
